<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- the server projects reference the server-side LiteLink; letting that flow in globally
         would collide with LiteLink.Client's copy of the shared sources, so every reference is
         explicit and the server side lives behind the "server" alias -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteLink.ClientGen.Tests.Models\LiteLink.ClientGen.Tests.Models.csproj" />
    <ProjectReference Include="..\LiteLink.Client\LiteLink.Client.csproj" />
    <ProjectReference Include="..\LiteLink\LiteLink.csproj" Aliases="server" />
    <ProjectReference Include="..\LiteLink.ClientGen.Tests.Server\LiteLink.ClientGen.Tests.Server.csproj" Aliases="server" />
    <!-- the generator runs on THIS assembly in client mode: [assembly: RpcClientModels] -->
    <ProjectReference Include="..\LiteLink.Generator\LiteLink.Generator.csproj"
                   OutputItemType="Analyzer"
                   ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
