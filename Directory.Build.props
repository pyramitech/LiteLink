<Project>

  <!-- Shared build and NuGet metadata for every project in the solution. Test, benchmark and
       shared (.shproj) projects opt out of packing themselves; everything else produces a package
       under artifacts/packages when packed (see pack.ps1). -->

  <PropertyGroup>
    <Version>1.0.1</Version>
    <Authors>Pyrami Technologies</Authors>
    <Company>Pyrami Technologies</Company>
    <Copyright>Copyright (c) Pyrami Technologies</Copyright>
    <Product>LiteLink</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>rpc;serialization;binary;signalr;tcp;quic;named-pipes;source-generator</PackageTags>
    <!-- fill these in once the public repository exists; both are optional for packing. Until
         RepositoryUrl is set, no repository/commit metadata is written into the packages (with
         PublishRepositoryUrl on, SourceLink would otherwise record whatever git remote the
         packing checkout happens to have). -->
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl></RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryUrl)' != ''">git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages\</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- symbols and reproducible builds: SourceLink is built into the SDK, it only needs the
         repository metadata above and a git checkout -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl Condition="'$(RepositoryUrl)' != ''">true</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries Condition="'$(RepositoryUrl)' == ''">false</EnableSourceControlManagerQueries>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- XML docs ship in the packages so IntelliSense shows the member documentation;
         members without a doc comment are not an error -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Per-package metadata lives here rather than in the .csproj files on purpose: the project
       files are synced verbatim from the private development repository, while this file exists
       only in the public one. -->
  <PropertyGroup>
    <!-- the generator is not a package of its own; it ships inside LiteLink and LiteLink.Client
         as an analyzer (see Directory.Build.targets) -->
    <IsPackable Condition="'$(MSBuildProjectName)' == 'LiteLink.Generator'">false</IsPackable>
    <PackGenerator Condition="'$(MSBuildProjectName)' == 'LiteLink' or '$(MSBuildProjectName)' == 'LiteLink.Client'">true</PackGenerator>
  </PropertyGroup>

  <PropertyGroup>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink'">LiteLink server core: RpcServer, connection links, permissions, middleware and the binary serializer. Brings the LiteLink.Generator source generator along, so referencing this package is all a server needs.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.Client'">LiteLink .NET client: RpcClient with handshake-driven dynamic serialization, multichannel calls, batching and server push handling. Transport packages: LiteLink.Tcp.Client, LiteLink.Quic.Client, LiteLink.Pipes.Client, LiteLink.SignalR.Client. Brings the LiteLink.Generator source generator along for [assembly: RpcClientModels].</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.SignalR'">LiteLink SignalR transport for ASP.NET Core: hosts the RpcServer on a SignalR hub (AddLiteLinkProtocol / UseLiteLink), the transport browsers and the litelink-web TypeScript client connect through.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.SignalR.Client'">LiteLink .NET client transport over SignalR (HubConnection).</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.Tcp'">LiteLink raw TCP transport with optional TLS; standalone, no ASP.NET Core required. Also the host for LiteLink.Gateway.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.Tcp.Client'">LiteLink .NET client transport over raw TCP with optional TLS.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.Quic'">LiteLink QUIC transport (always TLS 1.3, ALPN litelink); requires msquic on the host.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.Quic.Client'">LiteLink .NET client transport over QUIC; requires msquic on the host.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.Pipes'">LiteLink named pipe transport for same-machine IPC on Windows and Linux, with kernel-asserted peer identity and an authorization hook.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.Pipes.Client'">LiteLink .NET client transport over named pipes (Windows and Linux).</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'LiteLink.Gateway'">LiteLink protocol-transparent gateway: intercept, analyze, rewrite, reject or redirect client messages in front of one or more backend servers; plugs into the TCP and QUIC transports as the connection handler.</Description>
  </PropertyGroup>

</Project>
