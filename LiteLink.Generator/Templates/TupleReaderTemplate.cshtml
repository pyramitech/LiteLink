@inherits RazorBlade.PlainTextTemplate<LiteLink.Generators.Emit.TupleSerializerModel>
@namespace LiteLink.Generators.Templates
@using LiteLink.Generators.Emit
@using System.Linq
        public static @Model.TypeDisplay Read@(Model.FuncName)(this ref LiteReader reader)
        {
            return new @(Model.TypeDisplay)(@(string.Join(", ", Model.ElementTypeKeys.Select(x => TemplateHelpers.ReadCall(x)))));
        }
