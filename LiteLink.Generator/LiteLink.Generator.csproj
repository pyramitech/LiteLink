<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <PropertyGroup>
    <!-- not a package of its own: the generator is bundled as an analyzer into the LiteLink and
         LiteLink.Client packages (Directory.Build.targets), so consumers never reference it -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="RazorBlade" Version="0.11.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Compiles the RazorBlade runtime as source into this assembly, so the
         generator has no runtime dependency when loaded by the compiler. -->
    <RazorBladeEmbeddedLibrary>true</RazorBladeEmbeddedLibrary>
  </PropertyGroup>

	<PropertyGroup>
		<NoWarn>
			$(NoWarn);RS1035
		</NoWarn>
	</PropertyGroup>
	
  <Import Project="..\LiteLink.Shared.Func\LiteLink.Shared.Func.projitems" Label="Shared" />
  
</Project>
