<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Description>LiteLink .NET client: RpcClient with handshake-driven dynamic serialization, multichannel calls, batching and server push handling. Transport packages: LiteLink.Tcp.Client, LiteLink.Quic.Client, LiteLink.Pipes.Client, LiteLink.SignalR.Client. Brings the LiteLink.Generator source generator along for [assembly: RpcClientModels].</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.6" />
  </ItemGroup>

  <!-- the source generator ships inside this package too (see Directory.Build.targets):
       clients opting into generated serializers via [assembly: RpcClientModels] need it -->
  <PropertyGroup>
    <PackGenerator>true</PackGenerator>
  </PropertyGroup>

  <Import Project="..\LiteLink.Shared\LiteLink.Shared.projitems" Label="Shared" />

  <Import Project="..\LiteLink.Shared.Func\LiteLink.Shared.Func.projitems" Label="Shared" />

</Project>
