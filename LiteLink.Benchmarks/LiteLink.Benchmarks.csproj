<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- benchmarks compare relative numbers, they must not run on debug codegen -->
    <Optimize>true</Optimize>
    <!-- the host references the server-side LiteLink; keep it out of the global namespace so it
         can't collide with LiteLink.Client's copy of the shared sources -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- server surface and models; loading any of its types runs the generated server initializer -->
    <ProjectReference Include="..\LiteLink.Benchmarks.Host\LiteLink.Benchmarks.Host.csproj" />
    <ProjectReference Include="..\LiteLink.Client\LiteLink.Client.csproj" />
    <ProjectReference Include="..\LiteLink\LiteLink.csproj" Aliases="server" />
    <!-- the generator runs on THIS assembly in client mode: [assembly: RpcClientModels] -->
    <ProjectReference Include="..\LiteLink.Generator\LiteLink.Generator.csproj"
                   OutputItemType="Analyzer"
                   ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
