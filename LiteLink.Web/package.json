{
  "name": "litelink-web",
  "version": "1.0.0",
  "description": "TypeScript/browser client for LiteLink, the RPC framework with a compact binary serialization format: handshake-driven serializers, multichannel calls, request batching and server push over SignalR.",
  "keywords": [
    "litelink",
    "rpc",
    "signalr",
    "binary",
    "serialization",
    "websocket"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "clean": "tsc --build --clean",
    "prepublishOnly": "npm run build && npm test"
  },
  "author": "Pyrami Technologies",
  "license": "Apache-2.0",
  "devDependencies": {
    "@rollup/plugin-wasm": "^6.1.3",
    "esbuild": "^0.19.0",
    "lz4-wasm-nodejs": "^0.9.2",
    "rollup-plugin-dts": "^5.3.1",
    "rollup-plugin-esbuild": "^5.0.0",
    "typescript": "^5.1.6",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@microsoft/signalr": "^7.0.7",
    "lz4-wasm": "^0.9.2"
  }
}
