<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Description>LiteLink QUIC transport (always TLS 1.3, ALPN litelink); requires msquic on the host.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- System.Net.Quic is platform-annotated (win/linux/macos); StartAsync guards at
         runtime via QuicListener.IsSupported, which CA1416 can't see -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteLink\LiteLink.csproj" />
  </ItemGroup>

  <Import Project="..\LiteLink.Transport.Shared\LiteLink.Transport.Shared.projitems" Label="Shared" />

</Project>
